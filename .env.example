# ==============================================================
# .env.example — Copy this to .env and fill in real values
# NEVER commit .env to version control
# ==============================================================

PORT=5000
NODE_ENV=development

# Supabase Database
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# SMTP Email Configuration (Gmail SMTP with App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Admin / Notification email
ADMIN_EMAIL=

# Mail configuration (used by Python/Flask backend)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
